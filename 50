SELECT miasto miejscowosc FROM Klienci UNION SELECT miasto miejscowosc FROM Dostawcy;

SELECT imie, nazwisko, 'Klient' AS rola FROM Klienci UNION ALL SELECT imie, nazwisko, 'Dostawca' AS rola FROM Dostawcy;

SELECT imie, nazwisko FROM Klienci EXCEPT SELECT imie, nazwisko FROM Dostawcy;

SELECT miasto FROM Klienci INTERSECT SELECT miasto FROM Dostawcy;

SELECT imie, nazwisko, miasto FROM Klienci WHERE miasto = 'Warszawa' UNION SELECT imie, nazwisko, miasto FROM Dostawcy WHERE miasto = 'Kraków';
